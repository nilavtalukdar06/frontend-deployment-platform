NODE_ENV=development
PORT=4000

DATABASE_URL=postgresql://user:password@ep-example-pooler.region.aws.neon.tech/neondb?sslmode=require
REDIS_URL=redis://localhost:6379

CORS_ORIGIN=*

JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters-access
JWT_REFRESH_SECRET=replace-with-at-least-32-random-characters-refresh
JWT_ISSUER=auth-service
JWT_AUDIENCE=react-deployment-platform
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=604800

LOGIN_MAX_ATTEMPTS=5
LOGIN_ATTEMPT_WINDOW_SECONDS=900
LOGIN_LOCK_SECONDS=900

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

LOG_LEVEL=info
SHUTDOWN_TIMEOUT_MS=10000

REDIS_PORT=6379
AUTH_SERVICE_PORT=4000
