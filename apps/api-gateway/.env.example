NODE_ENV=development
PORT=3000

AUTH_SERVICE_URL=http://localhost:4000
PROJECT_SERVICE_URL=http://localhost:4001
REALTIME_SERVICE_URL=http://localhost:4003
ANALYTICS_SERVICE_URL=http://localhost:4004
LOGS_SERVICE_URL=http://localhost:4005
REDIS_URL=redis://localhost:6379

JWT_ACCESS_SECRET=replace-with-the-auth-service-access-secret-value
JWT_ISSUER=auth-service
JWT_AUDIENCE=react-deployment-platform

PROXY_TIMEOUT_MS=30000
HEALTH_CHECK_TIMEOUT_MS=3000
MAX_REQUEST_BODY_BYTES=65536
MAX_WEBHOOK_BODY_BYTES=5242880

CORS_ORIGIN=*

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
CREDENTIAL_RATE_LIMIT_WINDOW_MS=900000
CREDENTIAL_RATE_LIMIT_MAX=20
WEBHOOK_RATE_LIMIT_WINDOW_MS=60000
WEBHOOK_RATE_LIMIT_MAX=600

LOG_LEVEL=info
SHUTDOWN_TIMEOUT_MS=10000

API_GATEWAY_PORT=3000
