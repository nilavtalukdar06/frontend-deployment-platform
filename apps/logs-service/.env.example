NODE_ENV=development
PORT=4005

DATABASE_URL=postgresql://user:password@ep-example-pooler.region.aws.neon.tech/neondb?sslmode=require

KAFKA_BROKERS=your-kafka-host.aivencloud.com:12345
KAFKA_USERNAME=avnadmin
KAFKA_PASSWORD=your-kafka-password
KAFKA_SASL_MECHANISM=scram-sha-256
KAFKA_CA_CERT_PATH=ca.pem
KAFKA_CLIENT_ID=logs-service
KAFKA_DEPLOYMENT_LOGS_TOPIC=deployment-logs
KAFKA_CONSUMER_GROUP_ID=log-worker
KAFKA_CONSUMER_FROM_BEGINNING=false
LOG_LEVEL=info
SHUTDOWN_TIMEOUT_MS=10000
CLICKHOUSE_URL=https://your-clickhouse-host.clickhouse.cloud:8443
CLICKHOUSE_USERNAME=default
CLICKHOUSE_PASSWORD=your-clickhouse-password
CLICKHOUSE_REQUEST_TIMEOUT_MS=10000

LOGS_SERVICE_PORT=4005
