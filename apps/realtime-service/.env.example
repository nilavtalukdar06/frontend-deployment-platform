NODE_ENV=development
PORT=4003

DATABASE_URL=postgresql://user:password@ep-example-pooler.region.aws.neon.tech/neondb?sslmode=require
REDIS_URL=redis://localhost:6379

JWT_ACCESS_SECRET=replace-with-the-auth-service-access-secret-value
JWT_ISSUER=auth-service
JWT_AUDIENCE=react-deployment-platform

KAFKA_BROKERS=your-kafka-host.aivencloud.com:12345
KAFKA_USERNAME=avnadmin
KAFKA_PASSWORD=your-kafka-password
KAFKA_SASL_MECHANISM=scram-sha-256
KAFKA_CA_CERT_PATH=ca.pem
KAFKA_CLIENT_ID=realtime-service
KAFKA_DEPLOYMENT_LOGS_TOPIC=deployment-logs
KAFKA_CONSUMER_GROUP_ID=realtime-service
KAFKA_CONSUMER_FROM_BEGINNING=false

CORS_ORIGIN=*
SOCKET_MAX_SUBSCRIPTIONS_PER_CLIENT=10

LOG_LEVEL=info
SHUTDOWN_TIMEOUT_MS=10000

REALTIME_SERVICE_PORT=4003
