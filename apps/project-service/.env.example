AUTH_SERVICE_URL=http://localhost:4000
AUTH_SERVICE_TIMEOUT_MS=3000
INTERNAL_API_KEY=replace-with-at-least-32-random-characters-internal

AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key

ECS_CLUSTER=deployment-cluster

S3_BUCKET_NAME=your-deployments-bucket


GITHUB_API_TIMEOUT_MS=5000

PUBLIC_API_URL=http://localhost:3000
WEBHOOK_MAX_BODY_BYTES=5242880

SITES_BASE_URL=http://localhost:8080

ENV_ENCRYPTION_KEY=MDAwMDAwMDAwMDAwMDAwMDAwMDAwMDAwMDAwMDAwMDA=

CORS_ORIGIN=*

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

LOG_LEVEL=info
SHUTDOWN_TIMEOUT_MS=10000

PROJECT_SERVICE_PORT=4001

POSTGRES_USER=project_user
