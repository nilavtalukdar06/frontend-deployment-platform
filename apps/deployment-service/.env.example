NODE_ENV=development

DEPLOYMENT_ID=
USER_ID=
GITHUB_TOKEN_ENCRYPTED=

DATABASE_URL=postgresql://user:password@ep-example-pooler.region.aws.neon.tech/neondb?sslmode=require
REDIS_URL=redis://localhost:6379

ENV_ENCRYPTION_KEY=MDAwMDAwMDAwMDAwMDAwMDAwMDAwMDAwMDAwMDAwMDA=

AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
S3_BUCKET_NAME=your-deployments-bucket

OUTPUT_DIR=output
BUILD_TIMEOUT_MS=900000
UPLOAD_CONCURRENCY=8

KAFKA_BROKERS=your-kafka-host.aivencloud.com:12345
KAFKA_USERNAME=avnadmin
KAFKA_PASSWORD=your-kafka-password
KAFKA_SASL_MECHANISM=scram-sha-256
KAFKA_CA_CERT_PATH=ca.pem
KAFKA_CLIENT_ID=deployment-service
KAFKA_DEPLOYMENT_LOGS_TOPIC=deployment-logs

DEPLOYMENT_LOG_BATCH_SIZE=500
DEPLOYMENT_LOG_FLUSH_INTERVAL_MS=250
DEPLOYMENT_LOG_BUFFER_LIMIT=20000
DEPLOYMENT_LOG_MAX_LINE_BYTES=8192

LOG_LEVEL=info
