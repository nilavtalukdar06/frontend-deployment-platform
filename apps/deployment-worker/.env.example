NODE_ENV=development

DATABASE_URL=postgresql://user:password@ep-example-pooler.region.aws.neon.tech/neondb?sslmode=require
REDIS_URL=redis://localhost:6379

AUTH_SERVICE_URL=http://localhost:4000
AUTH_SERVICE_TIMEOUT_MS=3000
INTERNAL_API_KEY=replace-with-at-least-32-random-characters-internal

ENV_ENCRYPTION_KEY=MDAwMDAwMDAwMDAwMDAwMDAwMDAwMDAwMDAwMDAwMDA=

AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key

ECS_CLUSTER=deployment-cluster
ECS_TASK_DEFINITION=deployment-service
ECS_CONTAINER_NAME=deployment-service
ECS_SUBNET_IDS=subnet-0123456789abcdef0,subnet-0fedcba9876543210
ECS_SECURITY_GROUP_IDS=sg-0123456789abcdef0
ECS_ASSIGN_PUBLIC_IP=ENABLED

DEPLOYMENT_WORKER_CONCURRENCY=1
DEPLOYMENT_LOCK_TTL_SECONDS=3600
DEPLOYMENT_LOCK_RETRY_DELAY_MS=10000

LOG_LEVEL=info
SHUTDOWN_TIMEOUT_MS=10000
